# ── data: never committed ──────────────────────────────────
# Fetchers create these directories on demand; a fresh clone has none.
data/
*.duckdb
*.duckdb.wal
platform/duckdb/

# ── secrets ────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── python ─────────────────────────────────────────────────
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# ── dbt build artifacts ────────────────────────────────────
# Scoped to the project rather than bare `target/`, so the pattern says where it applies.
transform/target/
transform/dbt_packages/
transform/logs/
# A random per-machine id dbt writes on first run. Not repo state.
transform/.user.yml

# ── os / editor ────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
